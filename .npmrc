strict-peer-dependencies=false
auto-install-peers=true
# Windows MAX_PATH (260 char) workaround: some packages' peer-dependency-
# suffixed .pnpm store directory names (e.g. react-native's) combined with
# their own deeply nested native (JNI/CMake) source trees exceed 260 chars,
# which the Android SDK's bundled ninja.exe doesn't handle even with
# Windows' LongPathsEnabled registry key set. Hashing long dependency-key
# directory names keeps every path under the limit on any OS.
virtual-store-dir-max-length=60
