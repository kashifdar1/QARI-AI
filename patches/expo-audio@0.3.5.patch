@@ -332,7 +332,14 @@ class AudioModule : Module() {
 
       Function("record") { ref: AudioRecorder ->
         checkRecordingPermission()
-        if (!ref.isPrepared) {
+        // Upstream bug (expo-audio 0.3.5): this condition was inverted
+        // (`if (!ref.isPrepared)`), so after a successful
+        // prepareToRecordAsync() (which sets isPrepared = true) this never
+        // called the real ref.record(), meaning MediaRecorder.start() was
+        // never invoked. isRecording stayed false forever, the output file
+        // stayed 0 bytes, and stop() later threw IllegalStateException
+        // (stop() on a MediaRecorder that was only prepared, never started).
+        if (ref.isPrepared) {
           ref.record()
         }
       }
